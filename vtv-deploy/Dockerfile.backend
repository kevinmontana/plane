# Backend de Plane VTV: imagen oficial 1.4.2 (digest fijado) + código del fork + parches de seguridad.
# Se construye desde la raíz del repo:  docker build -f vtv-deploy/Dockerfile.backend -t plane-backend-vtv:<tag> .
FROM makeplane/plane-backend@sha256:90032ce088708889b60c00d491897916f4deb882facda27db59fd10fb68729ef
COPY apps/api/plane/ /code/plane/
# CVE-2026-114136/114137/114138 (DRF < 3.18.2), certifi PYSEC-2026-4320, Django al parche 5.2.17
RUN pip install --no-cache-dir "djangorestframework==3.18.2" "django==5.2.17" "certifi>=2026.10.19" \
 && pip check \
 && python -c "import rest_framework, django, certifi; print(rest_framework.__version__, django.__version__, certifi.__version__)"
